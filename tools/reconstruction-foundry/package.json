{
  "name": "@omnitwin/reconstruction-foundry-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Operator CLI for private Reconstruction Foundry candidate preparation and verification",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "omnitwin-dist": "./dist/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "foundry": "tsx src/entry.ts",
    "grand-hall-matterport-boundary-contact-sheet": "tsx src/grand-hall-matterport-boundary-contact-sheet-entry.ts",
    "grand-hall-lcc-preflight": "tsx src/grand-hall-xgrids-lcc-preflight-entry.ts",
    "grand-hall-t554-acceptance": "tsx src/grand-hall-t554-acceptance-entry.ts",
    "grand-hall-t554-boundary-review": "tsx src/grand-hall-t554-boundary-review-entry.mts",
    "grand-hall-t554-cleanup-marker-evidence-v2": "tsx src/grand-hall-t554-cleanup-marker-evidence-entry.ts",
    "grand-hall-t554-interface-atlas": "tsx src/grand-hall-t554-interface-atlas-entry.ts",
    "grand-hall-t554-panorama-inventory-review": "tsx src/grand-hall-t554-panorama-inventory-review-entry.ts",
    "grand-hall-t554-panorama-review": "tsx src/grand-hall-t554-panorama-review-entry.ts",
    "grand-hall-t554-review-pack-v2": "tsx src/grand-hall-t554-review-pack-v2-entry.ts",
    "grand-hall-t554-review-pack-v3": "tsx src/grand-hall-t554-review-pack-v3-entry.ts",
    "grand-hall-t561-panorama-visual-observation": "tsx src/grand-hall-t561-panorama-visual-observation-entry.ts",
    "grand-hall-t561-author-observation-input": "tsx src/grand-hall-t561-real-observation-input-entry.ts",
    "lcc2-frontier": "tsx src/lcc2-frontier-entry.ts",
    "lcc2-ordered-inventory": "tsx src/lcc2-ordered-gaussian-inventory-entry.ts",
    "local-app": "tsx src/entry.ts local-app",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnitwin/reconstruction-foundry": "workspace:*",
    "@omnitwin/types": "workspace:*",
    "hash-wasm": "4.12.0",
    "sharp": "0.35.3",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "4.1.8"
  }
}
