{
  "name": "@omnitwin/reconstruction-foundry-cli",
  "version": "0.0.1",
  "private": true,
  "description": "Operator CLI for private Reconstruction Foundry candidate preparation and verification",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "foundry": "tsx src/entry.ts",
    "lcc2-frontier": "tsx src/lcc2-frontier-entry.ts",
    "local-app": "tsx src/entry.ts local-app",
    "build:offline-preview-worker": "node scripts/build-offline-preview-worker-artifact.mjs",
    "build:windows-x64-release": "node scripts/build-windows-x64-production-release.mjs",
    "generate:e57-environment": "node scripts/generate-local-e57-intake-environment-source.mjs",
    "materialize:e57-runtime": "tsx src/local-e57-runtime-bundle-entry.ts",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnitwin/reconstruction-foundry": "workspace:*",
    "@omnitwin/types": "workspace:*",
    "fflate": "0.8.2",
    "hash-wasm": "4.12.0"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3",
    "vitest": "4.1.8"
  }
}
