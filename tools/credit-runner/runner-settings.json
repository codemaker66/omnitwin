{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(git remote*)",
      "Bash(git config*)",
      "Bash(git -c*)",
      "Bash(gh *)",
      "Bash(railway*)",
      "Bash(vercel*)",
      "Bash(neonctl*)",
      "Bash(npx *)",
      "Bash(pnpm dlx*)",
      "Bash(pnpm exec vercel*)",
      "Bash(pnpm exec railway*)",
      "Bash(pnpm publish*)",
      "Bash(npm publish*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(.env*)",
      "Edit(**/.env*)",
      "Edit(**/Dockerfile*)",
      "Edit(**/.dockerignore)",
      "Edit(**/railway.json)",
      "Edit(**/railway.toml)",
      "Edit(**/nixpacks.toml)",
      "Edit(**/vercel.json)",
      "Edit(**/.npmrc)",
      "Edit(.github/**)",
      "Edit(.claude/settings*.json)",
      "Edit(docs/state/tasks.md)",
      "Edit(docs/sessions/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
