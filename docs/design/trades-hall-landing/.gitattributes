# Keep the immutable CMS bundles and selected source byte-identical on checkout.
.gitattributes text eol=lf
*.py text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
