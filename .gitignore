# react-email dev preview / export artifacts (regenerated via `pnpm email:dev` / `email:export`)
.react-email/
emails-out/
.email-export-test/

# Real customer list for seed-customers.ts — contains PII (emails), never commit.
# Template committed at packages/api/src/scripts/customers.example.json.
packages/api/src/scripts/customers.json

# Claude Code runtime state (locks/sessions are local; settings.json is committed).
.claude/*.lock
.claude/settings.local.json

# Local dev-database binaries + data (portable Postgres; see infra/dev-db/).
.dev-db/

# Production-smoke saved auth session (playwright storage state; never commit).
.smoke/

# One-off `tree` scratchpads — regenerate locally as needed.
web-structure.txt

# Local scratch + Playwright extension session artifacts (never committed).
tmp/
.playwright-cli/
.playwright-mcp/
artifacts/*
# ...except the 17 part manifests the generated-furniture contract test reads
# (artifacts/img2threejs/<model>/parts.json, ~100KB total). They were excluded
# along with 71MB of heavy intermediates, so that suite passed locally and could
# only ever fail on a fresh clone. Git does not descend into an excluded
# directory, so every level is re-included before the negation becomes reachable.
!artifacts/img2threejs/
artifacts/img2threejs/*
!artifacts/img2threejs/*/
artifacts/img2threejs/*/*
!artifacts/img2threejs/*/parts.json
*.log
/*.jpeg

.vercel

packages/web/public/twin/

# Cargo build output for the Foundry's native helpers (regenerated by `cargo build`).
# Each crate ships its own anchored `/target/` rule, but that rule is tracked content:
# switching to a branch without the crate removes the rule while leaving the untracked
# artifacts on disk, which is how ~6k files / 3.6 GB once surfaced as "uncommitted
# changes" on master. Only a root-level rule survives every branch switch.
tools/**/target/
