# =============================================================================
# Venviewer API — isolated Grand Hall staging values
# =============================================================================
# Configure these in the dedicated Railway staging API only. Replace every
# angle-bracket placeholder. Do not copy this file, any value, or any staging
# resource into production. Secret values belong in Railway's sealed variable
# fields, never in a committed .env file.
# Remove inherited SENTRY_DSN, SENTRY_ENVIRONMENT, SENTRY_TRACES_SAMPLE_RATE,
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT, SENTRY_RELEASE, POSTHOG_KEY,
# and POSTHOG_HOST variables entirely, including empty definitions. This
# isolated target deliberately has no production telemetry sink.
# Every local operator-only variable is also forbidden, including the admin
# relay selections, VENVIEWER_GRAND_HALL_REVIEWED_GIT_SHA, both bootstrap
# selectors, all four VENVIEWER_GRAND_HALL_R2_* mint inputs, and especially
# the long-lived writer-parent access key and secret. Their presence, even as
# an empty Railway variable, makes the deployed API fail startup.
# =============================================================================

NODE_ENV=production
PORT=3001

# Railway exposes this service variable to the Dockerfile as a build argument.
# Do not configure GIT_SHA independently.
BUILD_GIT_SHA=${{RAILWAY_GIT_COMMIT_SHA}}
BUILD_APP_VERSION=0.0.4
VENVIEWER_DEPLOYMENT_TARGET_ID=trades-hall-grand-hall-staging
VENVIEWER_STAGING_REVIEWED_GIT_SHA=<exact-reviewed-successor-sha>

# Pooled URL from the new staging-only Neon project. It must select the
# code-pinned role trades_hall_grand_hall_staging_owner and database
# trades_hall_grand_hall_staging. Use the matching direct URL only in the
# guarded local migration/bootstrap process.
DATABASE_URL=<new-staging-neon-pooled-url>
VENVIEWER_STAGING_EXPECTED_DATABASE_HOST=<exact-lowercase-pooled-host>.neon.tech

# Isolated staging Clerk application. The API does not need the publishable key.
CLERK_SECRET_KEY=<staging-sk_test-key>
CLERK_WEBHOOK_SECRET=<staging-whsec-key>

CORS_ORIGINS=https://<staging-preview>.vercel.app
FRONTEND_URL=https://<staging-preview>.vercel.app
VENVIEWER_STAGING_EXPECTED_WEB_ORIGIN=https://<staging-preview>.vercel.app
PUBLIC_API_ORIGIN=https://<staging-api-service>.up.railway.app

# Staging startup always requires Railway's own injected system identity,
# including while intake is disabled for authenticated QA:
# RAILWAY_PROJECT_NAME, RAILWAY_ENVIRONMENT_NAME, and RAILWAY_SERVICE_NAME must
# each equal trades-hall-grand-hall-staging, and RAILWAY_PUBLIC_DOMAIN must
# equal the hostname in PUBLIC_API_ORIGIN. RAILWAY_GIT_BRANCH must equal
# codex/grand-hall-exact-runtime. Do not create/override those system values.

# New private, default-jurisdiction R2 bucket and its bucket-scoped Object Read
# only serving credential. The account ID is exactly 32 lowercase hexadecimal
# characters; endpoint-like or mixed-case values are rejected.
RUNTIME_PROFILE_R2_ACCOUNT_ID=<staging-r2-account-id>
RUNTIME_PROFILE_R2_PRIVATE_BUCKET=trades-hall-grand-hall-staging
RUNTIME_PROFILE_R2_ACCESS_KEY_ID=<read-only-serving-access-key-id>
RUNTIME_PROFILE_R2_SECRET_ACCESS_KEY=<read-only-serving-secret-access-key>

# Normal resting state. Keep the five commented intake fields absent.
RUNTIME_PROFILE_INTAKE_ENABLED=false

# Temporary enabled window only: add all five together, then change enabled to
# true. The three child values come from the local DPAPI-protected mint flow.
# RUNTIME_PROFILE_INTAKE_TARGET_ID=trades-hall-grand-hall-staging
# RUNTIME_PROFILE_INTAKE_DEPLOYED_GIT_SHA=<exact-reviewed-successor-sha>
# RUNTIME_PROFILE_INTAKE_R2_ACCESS_KEY_ID=<temporary-child-access-key-id>
# RUNTIME_PROFILE_INTAKE_R2_SECRET_ACCESS_KEY=<temporary-child-secret-access-key>
# RUNTIME_PROFILE_INTAKE_R2_SESSION_TOKEN=<temporary-child-session-token>
