# =============================================================================
# VenViewer API — production environment template
# =============================================================================
# This is a feature-grouped reference, not a copy-every-line checklist.
# Configure the REQUIRED core/runtime-profile values and only the optional
# feature groups actually used by the selected service. For temporary Grand
# Hall intake, also configure the complete intake block while it is enabled.
# Source of truth: packages/api/src/env.ts. Values absent from that schema do
# not belong in Railway merely because an older deployment used them.
# =============================================================================

# Runtime — REQUIRED for staging/production behavior. Railway may inject PORT.
NODE_ENV=production
PORT=3001

# Commit provenance — Railway exposes this service variable to the Dockerfile
# as its declared build arg. The image derives runtime GIT_SHA from it; do not
# set GIT_SHA independently in Railway.
BUILD_GIT_SHA=${{RAILWAY_GIT_COMMIT_SHA}}
# Optional build metadata.
BUILD_TIMESTAMP=

# Database — REQUIRED; use a fresh staging database, never production.
# Get this from Neon console → your project → Branches → production → pooled connection.
# Must include sslmode=require. channel_binding=require is recommended.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Clerk — secret and webhook secret are REQUIRED when NODE_ENV=production.
# The publishable key is optional in the API service; the web build has its own
# required VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=pk_live_
CLERK_SECRET_KEY=sk_live_
CLERK_WEBHOOK_SECRET=whsec_

# CORS — set to the clean staging web origin (comma-separated if needed).
CORS_ORIGINS=https://venviewer.com,https://www.venviewer.com
# REQUIRED clean HTTPS origin for this API service.
PUBLIC_API_ORIGIN=https://api.venviewer.com

# Email — optional; without RESEND_API_KEY the service logs instead of sending.
RESEND_API_KEY=re_
EMAIL_FROM=VenViewer <notifications@venviewer.com>

# Legacy/general uploads — optional as one cohesive five-field group.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=venviewer-prod
R2_PUBLIC_URL=https://uploads.venviewer.com

# Reviewed runtime profiles — REQUIRED when NODE_ENV=production. Give these
# credentials Object Read only access to
# this private bucket. The bucket must have public access disabled and must be
# distinct from R2_BUCKET_NAME and both Foundry buckets. There is intentionally
# no runtime-profile public URL; the API performs every anonymous release gate.
RUNTIME_PROFILE_R2_ACCOUNT_ID=
RUNTIME_PROFILE_R2_ACCESS_KEY_ID=
RUNTIME_PROFILE_R2_SECRET_ACCESS_KEY=
RUNTIME_PROFILE_R2_PRIVATE_BUCKET=venviewer-prod-runtime-profiles-private
RUNTIME_PROFILE_INTAKE_ENABLED=false
# RUNTIME_PROFILE_INTAKE_TARGET_ID=production-eu-west-grand-hall
# Must exactly match the running image's Docker-stamped GIT_SHA above.
# RUNTIME_PROFILE_INTAKE_DEPLOYED_GIT_SHA=0123456789abcdef0123456789abcdef01234567
# RUNTIME_PROFILE_INTAKE_R2_ACCESS_KEY_ID=
# RUNTIME_PROFILE_INTAKE_R2_SECRET_ACCESS_KEY=
# RUNTIME_PROFILE_INTAKE_R2_SESSION_TOKEN=

# Evidence-to-Runtime Reconstruction Foundry — optional cohesive feature group.
# Keep candidates private and releases immutable/public in a separate bucket.
FOUNDRY_R2_ACCOUNT_ID=
FOUNDRY_R2_ACCESS_KEY_ID=
FOUNDRY_R2_SECRET_ACCESS_KEY=
FOUNDRY_R2_CANDIDATE_BUCKET=venviewer-foundry-private-candidates
FOUNDRY_R2_RELEASE_BUCKET=venviewer-foundry-public-releases
FOUNDRY_R2_PUBLIC_URL=https://releases.venviewer.com
# Public verification keys only. Never place a signing private key here.
# FOUNDRY_ED25519_PUBLIC_KEYS_JSON={"release-key-2026":"<base64-spki-der>"}

# Frontend URL — REQUIRED when NODE_ENV=production; use the staging web origin.
FRONTEND_URL=https://venviewer.com

# Sentry — error tracking (optional but strongly recommended in prod)
SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus scrape token — 16+ chars. /metrics returns 404 when unset.
# Generate: `openssl rand -hex 16`
METRICS_TOKEN=<generate-16-byte-hex>
