# =============================================================================
# Venviewer web — isolated Grand Hall staging Preview values
# =============================================================================
# Configure these only in the existing Vercel project's Preview environment,
# scoped to Git branch codex/grand-hall-exact-runtime. Vercel supplies VERCEL,
# VERCEL_ENV, VERCEL_TARGET_ENV, VERCEL_GIT_COMMIT_REF, and
# VERCEL_GIT_COMMIT_SHA when system environment variables are exposed; do not
# create or override those system values.
# All VITE_* values are public browser/build inputs. Never put a secret here.
# =============================================================================

VITE_DEPLOYMENT_TIER=staging

# Server-side build bindings entered from the reviewed deployment record. They
# are not VITE_* values and are not bundled into the browser. The SHA must be
# the exact reviewed successor. The Frontend API is the hostname encoded by
# the isolated Clerk pk_test_ publishable key (for example, *.clerk.accounts.dev).
VENVIEWER_STAGING_REVIEWED_GIT_SHA=<exact-reviewed-successor-sha>
VENVIEWER_STAGING_EXPECTED_API_ORIGIN=https://<dedicated-staging-service>.up.railway.app
VENVIEWER_STAGING_EXPECTED_CLERK_FRONTEND_API=<isolated-instance>.clerk.accounts.dev

# Enter the same dedicated, clean Railway HTTPS origin in both fields. The
# build rejects production, non-Railway, path-bearing, or mismatched origins.
VITE_API_URL=https://<dedicated-staging-service>.up.railway.app

# Publishable key from the isolated Clerk staging/development application.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_<isolated-staging-publishable-key>

# Do not define any Sentry, source-map-upload, or PostHog variable in this
# branch Preview. The staging build fails even on an empty inherited value so
# it cannot upload source maps or send QA traffic to a production telemetry
# project. Remove Preview/All-Environments inheritance for this branch.
