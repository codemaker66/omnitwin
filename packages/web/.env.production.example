# =============================================================================
# OMNITWIN Web — production environment template
# =============================================================================
# Copy each VITE_* KEY=value line into the Vercel Production environment.
# Grand Hall staging has a separate .env.grand-hall-staging.example checklist.
#
# All VITE_* vars are BUNDLED INTO THE CLIENT BUNDLE — they are publicly
# visible once the site is deployed. Only put public / publishable keys
# here. Never put a secret key (sk_live_*, server-only token, etc).
# =============================================================================

# Deployment tier. An omitted value also defaults to production.
VITE_DEPLOYMENT_TIER=production

# REQUIRED production API origin. The build guard requires this exact value.
VITE_API_URL=https://api.venviewer.com

# Production Clerk publishable key. Do not use a test/development key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_

# Sentry DSN for the web app (optional — frontend error tracking)
VITE_SENTRY_DSN=https://<key>@o<org-id>.ingest.sentry.io/<web-project-id>
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=<git-sha-or-vercel-git-commit-sha>
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# PostHog (optional — product analytics)
VITE_POSTHOG_KEY=phc_
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Stripe publishable key for client-side payment flows
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_

# =============================================================================
# Server-side build secrets for source-map upload
# =============================================================================
# These are NOT VITE_* variables and must never be exposed to the browser.
# Set all three together only in the build/deployment environment.

SENTRY_AUTH_TOKEN=sntrys_
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-web-project-slug>
