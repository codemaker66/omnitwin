{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm -F @omnitwin/types build && pnpm -F @omnitwin/web build && pnpm -F @omnitwin/web exec node scripts/prepare-amissing-book-resume.mjs && pnpm -F @omnitwin/web exec node scripts/version-amissing-book-audio.mjs dist/amissing-book dist/amissing-book",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/trades-hall/cards",
      "destination": "/trades-hall/cards/",
      "permanent": false
    },
    {
      "source": "/quiz",
      "destination": "/amissing-book/",
      "permanent": false
    },
    {
      "source": "/quiz/",
      "destination": "/amissing-book/",
      "permanent": false
    },
    {
      "source": "/trades-house/discover-your-craft",
      "destination": "/amissing-book/",
      "permanent": false
    },
    {
      "source": "/trades-house/discover-your-craft/",
      "destination": "/amissing-book/",
      "permanent": false
    },
    {
      "source": "/splats/:path*",
      "destination": "/work-in-progress",
      "permanent": false
    },
    {
      "source": "/fixtures/native-gaussians.splat",
      "destination": "/work-in-progress",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "omnitwin-web.vercel.app"
        }
      ],
      "destination": "https://venviewer.com/:path*",
      "permanent": true
    },
    {
      "source": "/tour",
      "destination": "/venues/trades-hall/twin",
      "permanent": false
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/living-hall",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/editor",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/venues/:venueSlug/rooms/:roomSlug",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private/brief/trades-hall-2026-04-27",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/private/brief/trades-hall-2026-04-27/",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/platform",
      "destination": "/platform/index.html"
    },
    {
      "source": "/platform/",
      "destination": "/platform/index.html"
    },
    {
      "source": "/amissing-book",
      "destination": "/amissing-book/index.html"
    },
    {
      "source": "/amissing-book/",
      "destination": "/amissing-book/index.html"
    },
    {
      "source": "/api/card-review",
      "destination": "/api/card-review"
    },
    {
      "source": "/trades-hall/cards/",
      "destination": "/trades-hall/cards/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/furniture/:slug/:version/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/trades-house-media/voice/:clip([0-9a-f]{16}\\.mp3)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:dir(images|rooms|room-plans|demo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/trades-house-media/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/trades-house-media/voice/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:file(th-building\\.png|favicon\\.svg|apple-touch-icon\\.png|icon-192\\.png|icon-512\\.png|icon-maskable-512\\.png|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/splats/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/amissing-book/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(self), accelerometer=(self)"
        }
      ]
    },
    {
      "source": "/amissing-book/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(self), accelerometer=(self)"
        }
      ]
    },
    {
      "source": "/amissing-book/:dir(art|audio|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/trades-hall/cards",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/trades-hall/cards/",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/trades-hall/cards/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    },
    {
      "source": "/trades-hall/cards/results.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}
