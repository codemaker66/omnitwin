VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Optional browser error tracking.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0

# Optional field web vitals: the share of page loads that report LCP, INP, CLS
# and TTFB, a decimal below 1 such as 0.5. Leave it unset: then none of the
# measurement code is in the build (set at all, even to 0, the entry keeps it).
# Off until the privacy page describes it; the API keeps nothing unless
# WEB_VITALS_COLLECTION=on. See docs/engineering/web-vitals.md.
# VITE_WEB_VITALS_SAMPLE_RATE=0.5

# Where staged Gaussian-splat tiles are served from in development.
# Tiles are NOT in the repo (~1 GB); stage them with:
#   pnpm --filter @omnitwin/xgrids-lcc2 lcc2 -- stage --scans "<capture root>" --out "<this path>" --manifest packages/web/src/data/generated/trades-hall-splat-bundles.ts
# Leave unset to run without a captured layer (procedural scene).
SPLAT_STAGING_ROOT=
# Production origin for the same tile names (R2). Leave unset in development.
VITE_SPLAT_BASE_URL=
