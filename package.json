{
  "name": "omnitwin",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Browser-based venue planning platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r --workspace-concurrency=1 --no-bail run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "capture:factory": "pnpm --filter @omnitwin/capture-factory capture --",
    "reconstruction:foundry": "pnpm --filter @omnitwin/reconstruction-foundry-cli foundry",
    "postinstall": "node ./packages/types/node_modules/typescript/bin/tsc --project packages/types/tsconfig.build.json && node ./packages/reconstruction-foundry/node_modules/typescript/bin/tsc --project packages/reconstruction-foundry/tsconfig.build.json"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@types/node": "22.20.1",
      "@eslint/plugin-kit": "0.3.4",
      "@humanfs/node@>=0.16 <0.16.8": "0.16.8",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=4": "5.0.9",
      "browserslist@>=4 <4.28.7": "4.28.7",
      "engine.io": "6.6.9",
      "esbuild": "0.25.0",
      "fast-uri": "3.1.6",
      "fast-xml-builder": "1.1.7",
      "fflate@>=0.6.0 <0.6.11": "0.6.11",
      "fflate@>=0.8.0 <0.8.3": "0.8.3",
      "find-my-way": "9.7.0",
      "flatted": "3.4.2",
      "js-cookie@<=3.0.5": "3.0.7",
      "nanoid@<4": "3.3.18",
      "ndarray-pixels": "5.2.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.26",
      "resend>svix": "1.92.2",
      "js-yaml": "4.3.1",
      "shell-quote": "1.10.0",
      "socket.io-parser": "4.2.7",
      "vite": "6.4.3",
      "ws@>=8.0.0 <8.21.0": "8.21.0"
    },
    "patchedDependencies": {
      "@sparkjsdev/spark@2.1.0": "patches/@sparkjsdev__spark@2.1.0.patch"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "typescript-eslint": "8.22.0"
  }
}
